# Vercel frontend environment variables (Vite embeds these in browser code).
# Import these into Vercel, select the appropriate deployment environment,
# and redeploy the frontend after making changes.
VITE_API_URL=https://brandgaurd-ibin.onrender.com
VITE_ORG_SLUG=nimbusdesk
VITE_DEMO_MODE=true
# Replace with the SEED_PASSWORD used when the fictional demo database was first seeded.
# This value is public in the browser: never use a real or private password here.
VITE_DEMO_PASSWORD=REPLACE_WITH_FICTIONAL_DEMO_PASSWORD
