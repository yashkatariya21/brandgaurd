# Copy to .env and fill in. Never commit .env.
OWNER_DB_PASSWORD=change-me-owner-password
APP_DB_PASSWORD=change-me-app-password
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000
# Password for the demo users created by the seed script (min 10 chars)
SEED_PASSWORD=
# Only for local dev when running outside Docker:
DATABASE_URL=postgresql://brandguard_app:change-me-app-password@localhost:5432/brandguard
MIGRATION_DATABASE_URL=postgresql://brandguard_owner:change-me-owner-password@localhost:5432/brandguard
