# ─── Copy this file to .env and fill in every value. ───────────────────────
# NEVER commit .env to git — it is gitignored.
#
# ── Generate random secrets ─────────────────────────────────────────────────
# DB passwords:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT secret:    python -c "import secrets; print(secrets.token_hex(32))"

# ── Database ─────────────────────────────────────────────────────────────────
OWNER_DB_PASSWORD=replace-with-a-unique-random-value
APP_DB_PASSWORD=replace-with-a-different-unique-random-value

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-output-from-the-command-above   # must be ≥32 chars
JWT_TTL_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Must be the exact Vercel URL — no trailing slash, no wildcard (*).
# LOCAL DEV:       http://localhost:3000
# VERCEL DEPLOY:   https://your-project.vercel.app
# Multiple origins (comma-separated, no spaces): https://a.vercel.app,https://b.vercel.app
CORS_ORIGINS=http://localhost:3000

# ── Seed data ────────────────────────────────────────────────────────────────
SEED_PASSWORD=replace-with-a-local-demo-password   # min 10 chars

# ── AI (optional) ────────────────────────────────────────────────────────────
# Leave blank to run in deterministic demo mode (no OpenAI calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Frontend env vars (Vite bakes these in at BUILD time) ────────────────────
#
# VITE_API_URL
#   LOCAL DEV: leave blank — Vite dev-server proxy forwards /v1 → localhost:8000
#   VERCEL:    set to your Render backend URL (no trailing slash)
#              e.g. https://brandguard-api.onrender.com
VITE_API_URL=

# VITE_DEMO_MODE
#   true  = show demo role buttons + role switcher + sample content loader
#   false = show only the email/password sign-in form
VITE_DEMO_MODE=true

# VITE_DEMO_PASSWORD
#   Password used by demo role buttons — must equal SEED_PASSWORD exactly.
#   This value is visible in the built JS bundle, so only use fictional demo data.
VITE_DEMO_PASSWORD=   # set to the same value as SEED_PASSWORD

# VITE_ORG_SLUG
#   Organisation slug for the demo workspace.  Matches the value in seed_data.py.
VITE_ORG_SLUG=nimbusdesk

# Opt in to live Red Team calls only after approving a spending cap.
# REDTEAM_LIVE_ENABLED=true
