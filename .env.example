# Copy to .env and replace every placeholder. Never commit .env.
# For each database password, generate a different URL-safe value with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
OWNER_DB_PASSWORD=replace-with-a-unique-random-value
APP_DB_PASSWORD=replace-with-a-different-unique-random-value
# Generate a long random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-output-from-the-command-above
JWT_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000
# Password shared by fictional seeded demo accounts (minimum 10 characters).
# Change this before using any non-local environment.
SEED_PASSWORD=replace-with-a-local-demo-password
# Optional. Leave blank for deterministic, clearly-labelled demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
